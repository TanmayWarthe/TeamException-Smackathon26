# =============================================================================
# CTIP - Campus Threat Intelligence Platform .gitignore
# =============================================================================

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
env/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
*.manifest
*.spec

# Testing & Code Quality
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Databases & Runtime State
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
backend/ctip.db
backend/test.db

# Node / Frontend / Chrome Extension Builds & Dependencies
node_modules/
dist/
dist-firefox/
frontend/dist/
extension/dist/
extension/dist-firefox/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Playwright & Browser Testing Cache
.playwright/
playwright/.cache/
test-results/

# Temporary Evidence & Candidate Runtime Artifacts
digital-twin/storage/screenshots/candidate_*
digital-twin/storage/embeddings/candidate_*
digital-twin/storage/logos/candidate_*
evidence/
tmp/
temp/

# Scratch & Temporary Testing Directories
test_*/
pdf*.txt
*.pdf
HOW_IT_WORKS.txt